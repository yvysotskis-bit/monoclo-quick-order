# --- Shopify ---
# Магазин, з якого приймаються замовлення (інші магазини відхиляються)
SHOPIFY_SHOP=ibvza0-1g.myshopify.com
# Client secret додатка (Dev Dashboard -> Settings). Потрібен для перевірки підпису App Proxy
SHOPIFY_API_SECRET=
# Публічна адреса магазину, звідки читаємо /products/<handle>.js (за замовчуванням https://<SHOPIFY_SHOP>)
STORE_ORIGIN=https://monoclo.com.ua

# --- Telegram ---
# НОВИЙ токен від @BotFather (старий, що був у коді теми, треба відкликати: /revoke)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1002684944342
# Довільний довгий рядок; Telegram передає його у заголовку вебхука
TELEGRAM_WEBHOOK_SECRET=
# Публічна адреса цього сервера (для scripts/set-telegram-webhook.js)
PUBLIC_URL=https://quick-order.example.com

# --- Налаштування ---
PORT=3000
TIMEZONE=Europe/Kyiv
WORK_HOURS_START=10
WORK_HOURS_END=20
MAX_QTY=10
