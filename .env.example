# --- Shopify ---
# Магазин, з якого приймаються замовлення (інші магазини відхиляються)
SHOPIFY_SHOP=ibvza0-1g.myshopify.com
# Client secret додатка (Dev Dashboard -> Settings). Потрібен для перевірки підпису App Proxy
SHOPIFY_API_SECRET=
# Публічна адреса магазину, звідки читаємо /products/<handle>.js (за замовчуванням https://<SHOPIFY_SHOP>)
STORE_ORIGIN=https://monoclo.com.ua

# --- Telegram ---
# НОВИЙ токен від @BotFather (старий, що був у коді теми, треба відкликати: /revoke)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1002684944342
# Довільний довгий рядок; Telegram передає його у заголовку вебхука
TELEGRAM_WEBHOOK_SECRET=
# Публічна адреса цього сервера (для scripts/set-telegram-webhook.js)
PUBLIC_URL=https://monoclo-quick-order.onrender.com

# --- Налаштування ---
PORT=3000
TIMEZONE=Europe/Kyiv
WORK_HOURS_START=10
WORK_HOURS_END=20
MAX_QTY=10

# --- База даних ---
# На Render додайте Disk (Mount Path /data): тоді база лежатиме в /data/quick-order.db і переживе перезапуски
DB_PATH=/data/quick-order.db

# --- KeyCRM (необовʼязково) ---
# Settings → API у KeyCRM. Без ключа замовлення йдуть лише в Telegram
KEYCRM_API_KEY=
# Джерело «Monoclo QuickOrders» у KeyCRM
KEYCRM_SOURCE_ID=216
# Відповідність статусів Telegram → статуси KeyCRM (id зі Settings → Статуси). Можна лишити порожнім або заповнити частково
# Ключі: taken, no_answer, confirmed, shipped, cancelled, spam, new
KEYCRM_STATUS_MAP={"cancelled":19,"spam":13,"shipped":9}

# --- Нагадування та звіт ---
REMINDER_MINUTES=15
REMINDER_REPEAT_MINUTES=30
REMINDER_MAX=3
# Нагадувати лише про замовлення, створені не раніше цієї дати (UTC). Порожньо = про всі без статусу
REMINDERS_FROM=
REPORT_DAY=1
REPORT_HOUR=9

# --- Передоплата через Monobank (Plata by mono), необовʼязково ---
# Токен (X-Token) з кабінету mono для бізнесу. Без нього кнопки «💳 Передоплата» не буде
MONOBANK_TOKEN=
# Сума передоплати в гривнях (для першої перевірки поставте 1)
PREPAY_AMOUNT_UAH=200
# Скільки годин діє посилання
PAY_VALIDITY_HOURS=24
# Максимальна сума, яку менеджер може ввести кнопкою «Інша сума» (грн)
PAY_MAX_AMOUNT_UAH=50000
# Спосіб оплати в KeyCRM (Settings → Способи оплати), щоб передоплата фіксувалась у замовленні. 0 = не фіксувати
KEYCRM_PAYMENT_METHOD_ID=0

# --- Нова пошта (необовʼязково) ---
# Ключ API з кабінету my.novaposhta.ua (Налаштування → Безпека → Ключі API). Без нього місто й відділення вводяться вручну
NOVA_POSHTA_API_KEY=
# Служба доставки «Нова пошта» у KeyCRM (Налаштування → Служби доставки); 0 = не вказувати
KEYCRM_NOVA_POSHTA_SERVICE_ID=0
