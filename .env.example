# --- Shopify ---
# Магазин, з якого приймаються замовлення (інші магазини відхиляються)
SHOPIFY_SHOP=ibvza0-1g.myshopify.com
# Client secret додатка (Dev Dashboard -> Settings). Потрібен для перевірки підпису App Proxy
SHOPIFY_API_SECRET=
# Публічна адреса магазину, звідки читаємо /products/<handle>.js (за замовчуванням https://<SHOPIFY_SHOP>)
STORE_ORIGIN=https://monoclo.com.ua

# --- Telegram ---
# НОВИЙ токен від @BotFather (старий, що був у коді теми, треба відкликати: /revoke)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1002684944342
# Довільний довгий рядок; Telegram передає його у заголовку вебхука
TELEGRAM_WEBHOOK_SECRET=
# Публічна адреса цього сервера (для scripts/set-telegram-webhook.js)
PUBLIC_URL=https://monoclo-quick-order.onrender.com

# --- Налаштування ---
PORT=3000
TIMEZONE=Europe/Kyiv
WORK_HOURS_START=10
WORK_HOURS_END=20
MAX_QTY=10

# --- База даних ---
# На Render додайте Disk (Mount Path /data): тоді база лежатиме в /data/quick-order.db і переживе перезапуски
DB_PATH=/data/quick-order.db

# --- KeyCRM (необовʼязково) ---
# Settings → API у KeyCRM. Без ключа замовлення йдуть лише в Telegram
KEYCRM_API_KEY=
# Джерело «Monoclo QuickOrders» у KeyCRM
KEYCRM_SOURCE_ID=216
# Відповідність статусів Telegram → статуси KeyCRM (id зі Settings → Статуси). Можна лишити порожнім або заповнити частково
# Ключі: taken, no_answer, confirmed, shipped, cancelled, spam, new
KEYCRM_STATUS_MAP={"cancelled":19,"spam":13,"shipped":9}

# --- Нагадування та звіт ---
REMINDER_MINUTES=15
REMINDER_REPEAT_MINUTES=30
REMINDER_MAX=3
# Нагадувати лише про замовлення, створені не раніше цієї дати (UTC). Порожньо = про всі без статусу
REMINDERS_FROM=
REPORT_DAY=1
REPORT_HOUR=9

# --- Передоплата через Monobank (Plata by mono), необовʼязково ---
# Токен (X-Token) з кабінету mono для бізнесу. Без нього кнопки «💳 Передоплата» не буде
MONOBANK_TOKEN=
# Сума передоплати в гривнях (для першої перевірки поставте 1)
PREPAY_AMOUNT_UAH=200
# Скільки годин діє посилання
PAY_VALIDITY_HOURS=24
# Максимальна сума, яку менеджер може ввести кнопкою «Інша сума» (грн)
PAY_MAX_AMOUNT_UAH=50000
# Спосіб оплати в KeyCRM (Settings → Способи оплати), щоб передоплата фіксувалась у замовленні. 0 = не фіксувати
KEYCRM_PAYMENT_METHOD_ID=0

# --- Нова пошта (необовʼязково) ---
# Ключ API з кабінету my.novaposhta.ua (Налаштування → Безпека → Ключі API). Без нього місто й відділення вводяться вручну
NOVA_POSHTA_API_KEY=
# Служба доставки «Нова пошта» у KeyCRM (Налаштування → Служби доставки); 0 = не вказувати
KEYCRM_NOVA_POSHTA_SERVICE_ID=0

# ТТН Нової пошти (кнопка «📦 Створити ТТН» після оплати). Усе необовʼязково, значення за замовчуванням:
# NP_SENDER_CITY=Чернівці
# NP_SENDER_WAREHOUSE=31
# NP_SENDER_PHONE=380XXXXXXXXX   # якщо порожньо, береться телефон контактної особи з кабінету НП
# NP_WEIGHT_KG=1
# NP_LENGTH_CM=30
# NP_WIDTH_CM=25
# NP_HEIGHT_CM=5
# NP_DESCRIPTION=Monoclo
# NP_COD_MODE=control   # control = «Контроль оплати», transfer = «Грошовий переказ»

# Статус KeyCRM після створення ТТН (id зі списку статусів, 0 = не змінювати)
# KEYCRM_TTN_STATUS_ID=1

# Щоденна резервна копія бази (04:00 за Києвом). Копії на диску Render зберігаються поруч із базою в /data/backups.
# BACKUP_CHAT_ID — ваш ПРИВАТНИЙ чат з ботом (не група менеджерів): копія містить телефони клієнтів.
# BACKUP_HOUR=4
# BACKUP_KEEP=7
# BACKUP_CHAT_ID=

# --- Покупка для реклами (оплата + ТТН → Meta, GA4, Google Ads) ---
# 1 = увімкнено. Покупкою стає швидке замовлення, у якого є і оплата, і ТТН (із бота або додані вручну в KeyCRM)
# CONVERSIONS_ENABLED=1
# 1 = тестовий режим: покупки зараховуються й пишуться в лог Render, але нікуди не відправляються
# CONVERSIONS_DRY_RUN=1
# Не зараховувати замовлення, створені раніше цієї дати (UTC). Без неї: лише замовлення після першого ввімкнення
# CONVERSIONS_FROM=2026-10-01T00:00:00Z
# CONVERSIONS_LOOKBACK_DAYS=30
# Статуси KeyCRM, які ніколи не стають покупкою (id через кому), і групи статусів.
# Група 6 «Скасовано» вже містить 13 «Некоректні дані», 14 «Недозвон», 19 «Скасовано», 25 «Повернено» тощо
# CONVERSIONS_EXCLUDE_STATUS_IDS=
# CONVERSIONS_EXCLUDE_STATUS_GROUPS=6

# Інші джерела KeyCRM, чиї оплачені замовлення з ТТН теж ідуть у Meta як Purchase (UAH), id через кому.
# 198 = «Інстаграм | Monoclo» (Direct). Замовлення з тегом CAPI (вже відправлені старою інтеграцією) пропускаються
# CONVERSIONS_CRM_SOURCE_IDS=198

# Meta Conversions API: Events Manager → набір даних → Налаштування → Conversions API → Створити маркер доступу
# META_DATASET_ID=1258409115455825
# META_CAPI_TOKEN=
# Код тестових подій (Events Manager → Тестові події); прибрати після перевірки
# META_TEST_EVENT_CODE=
# Разово переслати в Meta покупки, зараховані до цієї дати (ті, що пішли з тестовим кодом). Після відправки змінну прибрати.
# CONVERSIONS_RESEND_META_BEFORE=2026-10-16T14:35:00Z
# Як товар записаний у каталозі Meta ({product_id}, {variant_id}, {sku}). У каталозі Shopify (510365305413392) ID контенту = ID варіанта
# META_CONTENT_ID={variant_id}
# META_API_VERSION=v24.0

# GA4 Measurement Protocol: Адміністратор → Потоки даних → потік сайту → Секретні ключі API Measurement Protocol
# GA4_MEASUREMENT_ID=G-D1XLRTFN7Q
# GA4_API_SECRET=

# Google Ads: файл офлайн-конверсій <PUBLIC_URL>/conversions/google-ads.csv для «Інструменти → Менеджер даних → HTTPS»
# Назва має точно збігатися з назвою дії-конверсії в Google Ads (джерело «Імпорт → Конверсії з кліків»)
# GADS_CONVERSION_NAME=Quick order purchase
# GADS_FEED_USER=googleads
# Довгий випадковий пароль; без нього файл недоступний
# GADS_FEED_PASSWORD=
