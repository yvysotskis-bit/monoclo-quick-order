{%- comment -%}
  Попап швидкого замовлення. App embed: вмикається один раз у Theme settings → App embeds
  і працює для всіх шаблонів товарів.
{%- endcomment -%}
{{ 'quick-order.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = block.settings
  assign accent = s.accent_color | default: '#000000'
-%}

<div
  class="qo-root"
  data-qo-root
  style="--qo-accent: {{ accent }}; --qo-radius: {{ s.radius | default: 2 }}px;"
>
  <dialog
    class="qo-dialog"
    data-qo-dialog
    aria-labelledby="qo-title"
    data-endpoint="/apps/quick-order/submit"
    data-work-start="{{ s.work_start | default: 10 }}"
    data-work-end="{{ s.work_end | default: 20 }}"
    data-timezone="Europe/Kyiv"
    data-color-map="{{ s.color_map | escape }}"
    data-size-guide-url="{{ s.size_guide_url | escape }}"
    data-size-helper="{{ s.size_helper }}"
    data-size-map-tee="{{ s.size_map_tee | default: 'XS:55, S:65, M:75, L:85, XL:95, XXL' | escape }}"
    data-size-map-hoodie="{{ s.size_map_hoodie | default: 'S:65, M:75, L:88, XL:100, XXL' | escape }}"
    data-instagram-url="{{ s.instagram_url | escape }}"
    data-after-hours-text="{{ s.after_hours_text | escape }}"
    data-max-qty="10"
    data-theme-mode="{{ s.theme_mode | default: 'time' }}"
    data-dark-from="{{ s.dark_from | default: 17 }}"
    data-light-from="{{ s.light_from | default: 6 }}"
    data-track-ga="{{ s.track_ga }}"
    data-track-meta="{{ s.track_meta }}"
  >
    <div class="qo-sheet" tabindex="-1" data-qo-sheet>
      <div class="qo-grabber" data-qo-grabber aria-hidden="true"><span></span></div>
      <button type="button" class="qo-close" data-qo-close aria-label="Закрити">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
      </button>

      <div class="qo-head" data-qo-head data-qo-swipe>
        <div class="qo-head__row">
          <div class="qo-head__media"><img alt="" width="96" height="96" data-qo-image></div>
          <div class="qo-head__info">
            <h2 class="qo-title" id="qo-title" data-qo-title></h2>
            <p class="qo-price">
              <span class="qo-price__now" data-qo-price></span>
              <s class="qo-price__old" data-qo-compare hidden></s>
              <span class="qo-badge" data-qo-badge hidden></span>
            </p>
          </div>
        </div>
        <div class="qo-steps" data-qo-steps>
          <button type="button" class="qo-steps__back" data-qo-back hidden>‹ Назад</button>
          <span class="qo-steps__label" data-qo-step-label aria-live="polite"></span>
          <span class="qo-steps__bar" aria-hidden="true"><i data-qo-bar></i></span>
        </div>
      </div>

      <div class="qo-body" data-qo-body>
        <section class="qo-view" data-qo-form-view>
          <form class="qo-form" id="qo-form" novalidate autocomplete="on" data-qo-form>
            <div class="qo-step" data-qo-step="1">
            <div data-qo-options></div>

            <div class="qo-field">
              <span class="qo-label" id="qo-qty-label">Кількість</span>
              <div class="qo-qty" role="group" aria-labelledby="qo-qty-label">
                <button type="button" class="qo-qty__btn" data-qo-qty="-1" aria-label="Менше">−</button>
                <input class="qo-qty__input" type="text" inputmode="numeric" value="1" readonly aria-live="polite" data-qo-qty-input>
                <button type="button" class="qo-qty__btn" data-qo-qty="1" aria-label="Більше">+</button>
              </div>
              <p class="qo-stock" data-qo-stock hidden></p>
            </div>

            <div class="qo-recap" data-qo-recap hidden>
              <div class="qo-recap__text">
                <span class="qo-recap__title">Дані для замовлення</span>
                <span class="qo-recap__line" data-qo-recap-line></span>
              </div>
              <button type="button" class="qo-recap__edit" data-qo-edit-data>Змінити</button>
            </div>
            </div>

            <div class="qo-step" data-qo-step="2" hidden>
            <p class="qo-note qo-note--hours qo-banner" data-qo-hours-note hidden></p>

            <div class="qo-field" data-qo-field="name">
              <label class="qo-label" for="qo-name">Ваше імʼя</label>
              <input class="qo-input" id="qo-name" name="name" type="text" autocomplete="given-name" autocapitalize="words" enterkeyhint="next" placeholder="Як до вас звертатися" maxlength="60" required data-qo-name>
              <p class="qo-hint qo-hint--field" data-qo-field-hint="name">Вкажіть імʼя, щоб менеджер знав, як до вас звертатися</p>
            </div>

            <div class="qo-field" data-qo-field="surname">
              <label class="qo-label" for="qo-surname">Прізвище <span class="qo-optional">(для накладної Нової пошти)</span></label>
              <input class="qo-input" id="qo-surname" name="surname" type="text" autocomplete="family-name" autocapitalize="words" enterkeyhint="next" placeholder="Ваше прізвище" maxlength="60" data-qo-surname>
            </div>

            <div class="qo-field" data-qo-field="phone">
              <label class="qo-label" for="qo-phone">Номер телефону</label>
              <div class="qo-phone">
                <span class="qo-phone__prefix" aria-hidden="true">+380</span>
                <input class="qo-input qo-input--phone" id="qo-phone" name="tel" type="tel" inputmode="numeric" autocomplete="tel-national" enterkeyhint="next" placeholder="(__) ___ __ __" required data-qo-phone aria-describedby="qo-phone-hint">
              </div>
              <p class="qo-hint qo-hint--field" id="qo-phone-hint" data-qo-field-hint="phone">Менеджер звʼяжеться за цим номером</p>
            </div>

            {%- if s.show_city -%}
              <div class="qo-delivery" data-qo-delivery data-np="{{ s.np_enabled }}" data-np-require="{{ s.np_require }}">
                <div class="qo-field" data-qo-field="city">
                  <label class="qo-label" for="qo-city">Місто{%- unless s.np_require %} <span class="qo-optional">(необовʼязково)</span>{%- endunless -%}</label>
                  <div class="qo-combo" data-qo-combo="city">
                    <input class="qo-input" id="qo-city" name="city" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="qo-city-list" autocomplete="off" autocapitalize="words" placeholder="Почніть вводити, наприклад «Київ»" maxlength="80" data-qo-city>
                    <ul class="qo-combo__list" id="qo-city-list" role="listbox" hidden></ul>
                  </div>
                  <p class="qo-hint qo-hint--field" data-qo-field-hint="city">Оберіть місто зі списку, і ми запропонуємо відділення Нової пошти</p>
                </div>

                <div class="qo-np" data-qo-np hidden>
                  <div class="qo-field">
                    <span class="qo-label" id="qo-method-label">Доставка Новою поштою</span>
                    <div class="qo-segment" role="radiogroup" aria-labelledby="qo-method-label">
                      <button type="button" class="qo-segment__btn" role="radio" aria-checked="true" data-qo-method="warehouse">Відділення</button>
                      <button type="button" class="qo-segment__btn" role="radio" aria-checked="false" tabindex="-1" data-qo-method="postomat">Поштомат</button>
                      <button type="button" class="qo-segment__btn" role="radio" aria-checked="false" tabindex="-1" data-qo-method="courier">Адресна</button>
                    </div>
                  </div>

                  <div class="qo-field" data-qo-field="point" data-qo-point-field>
                    <label class="qo-label" for="qo-point" data-qo-point-label>Відділення</label>
                    <div class="qo-combo" data-qo-combo="point">
                      <input class="qo-input" id="qo-point" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="qo-point-list" autocomplete="off" placeholder="Номер або адреса відділення" maxlength="80" data-qo-point>
                      <ul class="qo-combo__list" id="qo-point-list" role="listbox" hidden></ul>
                    </div>
                  </div>

                  <div class="qo-np__courier" data-qo-courier hidden>
                    <div class="qo-field" data-qo-field="street">
                      <label class="qo-label" for="qo-street">Вулиця</label>
                      <div class="qo-combo" data-qo-combo="street">
                        <input class="qo-input" id="qo-street" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="qo-street-list" autocomplete="off" placeholder="Почніть вводити назву вулиці" maxlength="80" data-qo-street>
                        <ul class="qo-combo__list" id="qo-street-list" role="listbox" hidden></ul>
                      </div>
                    </div>
                    <div class="qo-row">
                      <div class="qo-field" data-qo-field="house">
                        <label class="qo-label" for="qo-house">Будинок</label>
                        <input class="qo-input" id="qo-house" type="text" autocomplete="off" maxlength="20" data-qo-house>
                      </div>
                      <div class="qo-field">
                        <label class="qo-label" for="qo-apartment">Квартира</label>
                        <input class="qo-input" id="qo-apartment" type="text" autocomplete="off" maxlength="20" data-qo-apartment>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- if s.show_comment -%}
              <div class="qo-field">
                <label class="qo-label" for="qo-comment">Коментар <span class="qo-optional">(необовʼязково)</span></label>
                <textarea class="qo-input qo-input--area" id="qo-comment" name="comment" rows="2" maxlength="300" data-qo-comment></textarea>
              </div>
            {%- endif -%}

            <div class="qo-honeypot" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" data-qo-honeypot></label>
            </div>

            <dl class="qo-summary" data-qo-summary>
              <dt>Разом</dt>
              <dd data-qo-total></dd>
            </dl>
            </div>
          </form>
        </section>

        <section class="qo-view qo-success" data-qo-success-view hidden>
          <div class="qo-success__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28"><path d="M6 14.5l5.5 5.5L22 9" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square"/></svg>
          </div>
          <h2 class="qo-success__title" tabindex="-1" data-qo-success-title></h2>
          <dl class="qo-success__summary" data-qo-success-summary></dl>
          <p class="qo-note" data-qo-success-note></p>
          <p class="qo-note qo-note--hours" data-qo-success-hours hidden></p>
          {%- if s.telegram_url != blank -%}
            <p class="qo-note qo-note--contact">{{ s.account_hint | default: 'Ваш особистий кабінет MONOCLO у Telegram: замовлення, звʼязок із менеджером, сповіщення.' | escape }}</p>
          {%- endif -%}
          <div class="qo-success__actions">
            {%- if s.telegram_url != blank -%}
              <a class="qo-btn" href="{{ s.telegram_url }}" target="_blank" rel="noopener" data-qo-telegram>{{ s.account_label | default: 'Відкрити кабінет у Telegram' | escape }}</a>
              <button type="button" class="qo-btn qo-btn--ghost" data-qo-close>Продовжити покупки</button>
            {%- else -%}
              <button type="button" class="qo-btn" data-qo-close>Продовжити покупки</button>
            {%- endif -%}
            {%- if s.instagram_url != blank -%}
              <a class="qo-btn qo-btn--ghost" href="{{ s.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
            {%- endif -%}
          </div>
        </section>
      </div>

      <footer class="qo-footer" data-qo-footer>
        <p class="qo-error" data-qo-error role="alert" hidden></p>
        <p class="qo-hint qo-hint--cta" data-qo-cta-hint role="status" aria-live="polite"></p>
        <button type="submit" form="qo-form" class="qo-submit" data-qo-submit aria-disabled="true">
          <span class="qo-submit__label" data-qo-submit-label>Далі</span>
          <span class="qo-spinner" aria-hidden="true"></span>
        </button>
        <p class="qo-note" data-qo-note hidden>{{ s.response_note | escape }}</p>
      </footer>
    </div>
  </dialog>
</div>

<script src="{{ 'quick-order.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quick Order popup",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Тексти"
    },
    {
      "type": "textarea",
      "id": "response_note",
      "label": "Текст під кнопкою та на екрані успіху",
      "default": "Менеджер зв'яжеться з вами, як тільки звільниться. Очікуйте дзвінка та/або повідомлення для повного оформлення вашого замовлення."
    },
    {
      "type": "textarea",
      "id": "after_hours_text",
      "label": "Текст поза робочим часом",
      "info": "{start} і {end} замінюються на години роботи.",
      "default": "Замовлення приймаються щодня з {start} до {end}. Замовлення, оформлені поза цим часом, будуть опрацьовані наступного дня в порядку черги."
    },
    {
      "type": "header",
      "content": "Робочий час (Київ)"
    },
    {
      "type": "range",
      "id": "work_start",
      "label": "Початок",
      "min": 0,
      "max": 23,
      "step": 1,
      "unit": "год",
      "default": 10
    },
    {
      "type": "range",
      "id": "work_end",
      "label": "Кінець",
      "min": 1,
      "max": 24,
      "step": 1,
      "unit": "год",
      "default": 20
    },
    {
      "type": "header",
      "content": "Вигляд"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Колір головної кнопки",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Заокруглення кутів",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "textarea",
      "id": "color_map",
      "label": "Кольори для кружечків",
      "info": "Один колір на рядок: Назва:#hex. Чорний, білий, сірий та інші базові вже вбудовані.",
      "default": "Графітовий:#3b3b3d"
    },
    {
      "type": "header",
      "content": "Тема попапа"
    },
    {
      "type": "select",
      "id": "theme_mode",
      "label": "Світла чи темна",
      "options": [
        { "value": "time", "label": "За часом: світла вдень, темна ввечері" },
        { "value": "auto", "label": "Як у пристрої відвідувача" },
        { "value": "light", "label": "Завжди світла" },
        { "value": "dark", "label": "Завжди темна" }
      ],
      "default": "time"
    },
    {
      "type": "range",
      "id": "dark_from",
      "label": "Темна починається о (Київ)",
      "min": 0,
      "max": 23,
      "step": 1,
      "unit": "год",
      "default": 17
    },
    {
      "type": "range",
      "id": "light_from",
      "label": "Світла починається о (Київ)",
      "min": 0,
      "max": 23,
      "step": 1,
      "unit": "год",
      "default": 6
    },
    {
      "type": "header",
      "content": "Аналітика"
    },
    {
      "type": "checkbox",
      "id": "track_ga",
      "label": "Подія generate_lead в Google Analytics (gtag)",
      "info": "Працює, якщо на сайті підключено GA4 через gtag. Для Google Tag Manager є подія quick_order у dataLayer.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "track_meta",
      "label": "Подія Lead у Meta Pixel",
      "info": "Рахується як окрема конверсія «Lead» у рекламному кабінеті Facebook/Instagram.",
      "default": true
    },
    {
      "type": "header",
      "content": "Додатково"
    },
    {
      "type": "checkbox",
      "id": "show_city",
      "label": "Показувати місто та доставку Новою поштою",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "np_enabled",
      "label": "Списки міст, відділень і поштоматів Нової пошти",
      "info": "Клієнт обирає зі списку. Якщо вимкнути або сервіс недоступний, місто вводиться вручну.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "np_require",
      "label": "Робити доставку обовʼязковою",
      "info": "Без вибору міста й відділення (або адреси) замовлення не відправиться. Це може зменшити кількість замовлень.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "size_helper",
      "label": "Показувати «Підібрати розмір за зростом і вагою»",
      "default": true
    },
    {
      "type": "text",
      "id": "size_map_tee",
      "label": "Підбір розміру: футболки та інше",
      "default": "XS:55, S:65, M:75, L:85, XL:95, XXL",
      "info": "Розмір і верхня межа ваги в кг для людини зростом 175 см. Наприклад «M:75» означає: до 75 кг. Останній розмір без числа."
    },
    {
      "type": "text",
      "id": "size_map_hoodie",
      "label": "Підбір розміру: худі та светри",
      "default": "S:65, M:75, L:88, XL:100, XXL",
      "info": "Той самий формат. Для товарів із «худі», «hoodie» чи «світшот» у назві."
    },
    {
      "type": "url",
      "id": "size_guide_url",
      "label": "Посилання на таблицю розмірів"
    },
    {
      "type": "text",
      "id": "telegram_url",
      "label": "Посилання на Telegram-бот магазину (для екрана успіху)",
      "info": "Кнопка на екрані після замовлення. Повна адреса, що починається з https://. Залиште порожнім, щоб прибрати кнопку.",
      "default": "https://t.me/monoclo_store_bot?start=site"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Текст кнопки бота",
      "default": "Відкрити кабінет у Telegram"
    },
    {
      "type": "text",
      "id": "account_hint",
      "label": "Підказка над кнопками на екрані успіху",
      "default": "Ваш особистий кабінет MONOCLO у Telegram: замовлення, звʼязок із менеджером, сповіщення."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram (для екрана успіху)"
    },
    {
      "type": "checkbox",
      "id": "show_comment",
      "label": "Показувати поле «Коментар»",
      "default": false
    }
  ]
}
{% endschema %}
