{%- comment -%}
  Кнопка «Замовити в 1 клік». App block: додається в Customize на сторінці товару
  (Product information → Add block → Apps → Quick Order button), на будь-якому шаблоні.
  Сам попап живе в app embed «Quick Order popup».
{%- endcomment -%}
{%- assign qo_product = closest.product | default: product -%}
{{ 'quick-order.css' | asset_url | stylesheet_tag }}

{%- if qo_product -%}
  <div
    class="qo-block"
    data-qo-block
    data-qo-autofit="{{ block.settings.auto_fit }}"
    data-qo-gap="{{ block.settings.gap }}"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="qo-trigger qo-trigger--{{ block.settings.style }}"
      data-qo-open
      data-qo-product="qo-product-{{ block.id }}"
    >
      {{- block.settings.label | escape -}}
    </button>

    {%- if block.settings.sticky_mobile -%}
      <div class="qo-sticky" data-qo-sticky aria-hidden="true">
        <button
          type="button"
          class="qo-trigger qo-trigger--solid"
          data-qo-open
          data-qo-product="qo-product-{{ block.id }}"
          tabindex="-1"
        >
          {{- block.settings.label | escape -}}
        </button>
      </div>
    {%- endif -%}

    {%- if request.design_mode -%}
      <p class="qo-editor-note" data-qo-editor-note hidden>
        Увімкніть «Quick Order popup» у Theme settings → App embeds, інакше кнопка не працюватиме.
      </p>
    {%- endif -%}

    <script type="application/json" id="qo-product-{{ block.id }}">
      {
        "handle": {{ qo_product.handle | json }},
        "title": {{ qo_product.title | json }},
        "url": {{ qo_product.url | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "price": {{ qo_product.price | default: 0 }},
        "compare_at_price": {{ qo_product.compare_at_price | default: 0 }},
        "image": {% if qo_product.featured_image %}{{ qo_product.featured_image | image_url: width: 320 | json }}{% else %}null{% endif %},
        "selected_variant_id": {{ qo_product.selected_or_first_available_variant.id | default: 0 }},
        "images": [
          {%- for img in qo_product.images limit: 40 -%}
            {
              "src": {{ img | image_url: width: 320 | json }},
              "alt": {{ img.alt | default: '' | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "options": [
          {%- for option in qo_product.options_with_values -%}
            {
              "name": {{ option.name | json }},
              "values": {{ option.values | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "variants": [
          {%- for v in qo_product.variants -%}
            {
              "id": {{ v.id }},
              "title": {{ v.title | json }},
              "options": {{ v.options | json }},
              "available": {{ v.available | json }},
              "price": {{ v.price }},
              "compare_at_price": {{ v.compare_at_price | default: 0 }},
              "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 320 | json }}{% else %}null{% endif %},
              "stock": {% if v.inventory_management and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (document.querySelector('[data-qo-root]')) return;
        document.querySelectorAll('[data-qo-block]').forEach(function (block) {
          var note = block.querySelector('[data-qo-editor-note]');
          if (note) {
            note.hidden = false;
          } else {
            block.hidden = true;
          }
        });
      });
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Quick Order button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Текст кнопки",
      "default": "Замовити в 1 клік"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Стиль кнопки",
      "options": [
        { "value": "solid", "label": "Заповнена" },
        { "value": "outline", "label": "З рамкою (другорядна)" }
      ],
      "default": "outline"
    },
    {
      "type": "checkbox",
      "id": "auto_fit",
      "label": "Підтягнути до кнопки «Додати до кошика»",
      "info": "Автоматично прибирає великий відступ між кнопками. Форма, шрифт і висота кнопки копіюються з кнопки теми.",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Відстань до сусідніх кнопок",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile",
      "label": "Прилипаюча кнопка внизу на мобільному",
      "info": "Зʼявляється, коли основна кнопка пішла за межі екрана. Може перетинатися з власною sticky-панеллю теми.",
      "default": false
    }
  ]
}
{% endschema %}
