{%- comment -%}
  Кнопка «Замовити в 1 клік». App block: додається в Customize на сторінці товару
  (Product information → Add block → Apps → Quick Order button), на будь-якому шаблоні.
  Сам попап живе в app embed «Quick Order popup».
{%- endcomment -%}
{%- assign qo_product = closest.product | default: product -%}
{{ 'quick-order.css' | asset_url | stylesheet_tag }}

{%- if qo_product -%}
  <div
    class="qo-block"
    data-qo-block
    data-qo-autofit="{{ block.settings.auto_fit }}"
    data-qo-gap="{{ block.settings.gap }}"
    data-qo-nudge="{{ block.settings.nudge }}"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="qo-trigger qo-trigger--{{ block.settings.style }}"
      data-qo-open
      data-qo-product="qo-product-{{ block.id }}"
    >
      {{- block.settings.label | escape -}}
    </button>

    {%- comment -%}
      Підгонка кнопки під тему виконується тут, під час розбору сторінки (до першого малювання), щоб кнопка не змінювала розмір
      після завантаження quick-order.js. Повторні запуски (resize, редактор тем) викликає quick-order.js через window.__qoMatchTheme.
    {%- endcomment -%}
    <script>
      (function () {
        if (window.__qoMatchTheme) { window.__qoMatchTheme(); return; }
        var REF_SELECTORS = [
          'form[action*="/cart/add"] button[type="submit"]',
          'form[action*="/cart/add"] [name="add"]',
          '.product-form__submit',
          'button[name="add"]'
        ];

        function parseRgb(value) {
          var m = String(value).match(/rgba?\(([^)]+)\)/);
          if (!m) return null;
          var p = m[1].split(/[ ,\/]+/).filter(Boolean).map(parseFloat);
          return { r: p[0], g: p[1], b: p[2], a: p.length > 3 ? p[3] : 1 };
        }

        function isOpaque(c) { return c && c.a > 0.05; }

        function onAccent(c) {
          if (!c) return '#fff';
          var lum = (0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b) / 255;
          return lum > 0.6 ? '#000' : '#fff';
        }

        function findReference(blocks) {
          var triggerTop = blocks[0].querySelector('.qo-trigger').getBoundingClientRect().top;
          var best = null;
          var fallback = null;
          REF_SELECTORS.forEach(function (selector) {
            document.querySelectorAll(selector).forEach(function (node) {
              if (node.closest('.qo-root, .qo-block')) return;
              var rect = node.getBoundingClientRect();
              if (rect.width < 40 || rect.height < 20) return;
              fallback = fallback || node;
              // Найближча основна кнопка над нашою
              if (rect.bottom <= triggerTop + 1 && (!best || rect.bottom > best.getBoundingClientRect().bottom)) best = node;
            });
          });
          return { style: best || fallback, above: best };
        }

        function matchTheme() {
          var blocks = document.querySelectorAll('[data-qo-block]');
          if (!blocks.length) return;
          var ref = findReference(blocks);
          if (!ref.style) return;

          var cs = getComputedStyle(ref.style);
          var rect = ref.style.getBoundingClientRect();
          var bg = parseRgb(cs.backgroundColor);
          var border = parseRgb(cs.borderTopColor);
          var borderWidth = parseFloat(cs.borderTopWidth) || 0;
          var text = parseRgb(cs.color);
          var accent = isOpaque(bg) ? bg : (isOpaque(border) && borderWidth > 0 ? border : text);
          var accentCss = accent
            ? 'rgb(' + accent.r + ',' + accent.g + ',' + accent.b + ')'
            : '#000';
          var radius = parseFloat(cs.borderTopLeftRadius) || 0;
          if (radius >= rect.height / 2) radius = 999;

          var set = document.documentElement.style;
          set.setProperty('--qo-btn-radius', radius + 'px');
          set.setProperty('--qo-btn-border', Math.max(borderWidth, 1) + 'px');
          set.setProperty('--qo-btn-font', cs.fontFamily);
          set.setProperty('--qo-btn-weight', cs.fontWeight);
          set.setProperty('--qo-btn-size', cs.fontSize);
          set.setProperty('--qo-btn-spacing', cs.letterSpacing);
          set.setProperty('--qo-btn-transform', cs.textTransform);
          set.setProperty('--qo-btn-height', Math.round(Math.min(Math.max(rect.height, 40), 72)) + 'px');
          set.setProperty('--qo-btn-accent', accentCss);
          set.setProperty('--qo-btn-on-accent', onAccent(accent));
          set.setProperty('--qo-input-radius', Math.min(radius, 12) + 'px');

          fitSpacing(blocks, ref.above);
        }

        // Темам властивий великий відступ між блоками. Підтягуємо нашу кнопку до основної
        // і вирівнюємо відступ із нижнім сусідом.
        function fitSpacing(blocks, above) {
          blocks.forEach(function (block) {
            block.style.marginTop = '';
            block.style.marginBottom = '';
            if (block.dataset.qoAutofit !== 'true' || !above) return;
            var trigger = block.querySelector('.qo-trigger');
            var target = Number(block.dataset.qoGap);
            if (isNaN(target)) target = 12;
            var gap = trigger.getBoundingClientRect().top - above.getBoundingClientRect().bottom;
            if (gap > target + 2 && gap < 220) {
              var delta = Math.round(gap - target);
              block.style.marginTop = -delta + 'px';
              block.style.marginBottom = -delta + 'px';
            }
          });
        }

        window.__qoMatchTheme = matchTheme;
        matchTheme();
      })();
    </script>


    {%- if request.design_mode -%}
      <p class="qo-editor-note" data-qo-editor-note hidden>
        Увімкніть «Quick Order popup» у Theme settings → App embeds, інакше кнопка не працюватиме.
      </p>
    {%- endif -%}

    <script type="application/json" id="qo-product-{{ block.id }}">
      {
        "handle": {{ qo_product.handle | json }},
        "title": {{ qo_product.title | json }},
        "url": {{ qo_product.url | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "price": {{ qo_product.price | default: 0 }},
        "compare_at_price": {{ qo_product.compare_at_price | default: 0 }},
        "image": {% if qo_product.featured_image %}{{ qo_product.featured_image | image_url: width: 320 | json }}{% else %}null{% endif %},
        "selected_variant_id": {{ qo_product.selected_or_first_available_variant.id | default: 0 }},
        "images": [
          {%- for img in qo_product.images limit: 40 -%}
            {
              "src": {{ img | image_url: width: 320 | json }},
              "alt": {{ img.alt | default: '' | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "options": [
          {%- for option in qo_product.options_with_values -%}
            {
              "name": {{ option.name | json }},
              "values": {{ option.values | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "variants": [
          {%- for v in qo_product.variants -%}
            {
              "id": {{ v.id }},
              "sku": {{ v.sku | default: '' | json }},
              "title": {{ v.title | json }},
              "options": {{ v.options | json }},
              "available": {{ v.available | json }},
              "price": {{ v.price }},
              "compare_at_price": {{ v.compare_at_price | default: 0 }},
              "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 320 | json }}{% else %}null{% endif %},
              "stock": {% if v.inventory_management and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (document.querySelector('[data-qo-root]')) return;
        document.querySelectorAll('[data-qo-block]').forEach(function (block) {
          var note = block.querySelector('[data-qo-editor-note]');
          if (note) {
            note.hidden = false;
          } else {
            block.hidden = true;
          }
        });
      });
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Quick Order button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Текст кнопки",
      "default": "Замовити в 1 клік"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Стиль кнопки",
      "options": [
        { "value": "solid", "label": "Заповнена" },
        { "value": "outline", "label": "З рамкою (другорядна)" }
      ],
      "default": "outline"
    },
    {
      "type": "checkbox",
      "id": "auto_fit",
      "label": "Підтягнути до кнопки «Додати до кошика»",
      "info": "Автоматично прибирає великий відступ між кнопками. Форма, шрифт і висота кнопки копіюються з кнопки теми.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nudge",
      "label": "Легке підсвічування, якщо довго не натискають",
      "info": "Кнопка тричі коротко «пульсує», поки відвідувач її не торкнувся. Вимикається, якщо в пристрої вказано «зменшити рух».",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Відстань до сусідніх кнопок",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
